* text=auto eol=lf

# Source and config files
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix shell scripts
*.sh text eol=lf

# Common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.docx binary
*.pptx binary
*.xlsx binary

# Frozen evaluation evidence must retain the bytes recorded by its SHA-256 manifests.
/05_Software/aegis/evaluations/** -text
