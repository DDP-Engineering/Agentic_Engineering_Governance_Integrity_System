-          <tbody>
-            <tr><td>Product source lines</td><td class="n">74,055</td><td class="n">71,620</td><td class="n">351,079</td></tr>
-            <tr><td>Test lines</td><td class="n">69,836</td><td class="n">63,630</td><td class="n"><span class="sig bad">9,020</span></td></tr>
-            <tr><td>AEGIS period</td><td class="n">Jul 18 to Sep 17</td><td class="n">Aug 29 to Sep 17</td><td class="n">Aug 15 to Sep 10</td></tr>
-            <tr><td>Commits in period</td><td class="n">312</td><td class="n">145</td><td class="n">102</td></tr>
-            <tr><td>Task journals</td><td class="n">96</td><td class="n">45</td><td class="n">10</td></tr>
-            <tr><td>Quick path</td><td class="n">15 of 96</td><td class="n">4 of 45</td><td class="n">2 of 10</td></tr>
-            <tr><td>Task mix</td><td class="n">59 fix · 29 change · 7 feature</td><td class="n">30 feature · 14 change · 1 fix</td><td class="n">5 feature · 4 fix · 1 change</td></tr>
-            <tr><td>Requirement files</td><td class="n">717</td><td class="n">367</td><td class="n">27</td></tr>
-            <tr><td>With linked tests</td><td class="n"><span class="sig ok">710 · 99%</span></td><td class="n"><span class="sig ok">361 · 98%</span></td><td class="n"><span class="sig warn">20 · 74%</span></td></tr>
-            <tr><td>Manual or inspection verification</td><td class="n"><span class="sig ok">6</span></td><td class="n"><span class="sig ok">4</span></td><td class="n"><span class="sig bad">9 of 27</span></td></tr>
-            <tr><td>Knowledge pages</td><td class="n">18</td><td class="n">6</td><td class="n"><span class="sig warn">2</span></td></tr>
-          </tbody>
