# Python caches and local test/build state are never part of an AEGIS install.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Per-worktree AEGIS runtime state is created on demand and never tracked.
.agentic/.workspace/

# WAEGIS rollback journals. These hold verbatim backup copies of files a
# deployment command is about to overwrite, so committing them would publish
# the pre-change content of the operator's own files — and a `git add -A` run
# while an install is in flight would do exactly that. The directory is
# transient: it is rolled back or removed when the transaction terminates.
.agentic/.waegis-transactions/

# Project-local optional tool runtimes are installed by WAEGIS and verified
# from their sidecar manifests. They are never repository source material.
.agentic/tools/repowise/

# RepoWise indexes, execution metadata, and freshness receipts are local,
# reproducible discovery inputs. AEGIS persists only their validated,
# normalized run snapshot as durable workflow state.
.repowise/
.agentic/integrations/repowise-runtime.json
.agentic/integrations/repowise-receipt.json

# Adapter dependencies are installed on demand.
node_modules/
.vitest/
.opencode-cache/

# The CLI virtualenv is created by install.ps1 on every host; it is never
# repository source material. Without this entry a fresh project that follows
# the docs commits its own virtualenv (B23).
.venv/
.agentic/.venv/
