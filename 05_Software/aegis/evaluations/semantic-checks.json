    ],
    "holdout_frame_ambiguous_policy": [
      {"id": "inactivity_period_open", "type": "frame_open", "any": ["how long", "period", "duration", "threshold", "inactiv", "no longer used", "unused"]},
      {"id": "restorability_open", "type": "frame_open", "any": ["restor", "revers", "re-enable", "reenable", "reactivat", "undo"]},
      {"id": "no_invented_period", "type": "frame_no_quantity",
       "units": ["second", "minute", "hour", "day", "week", "month", "year"],
       "fields": ["Desired outcome", "In scope", "Constraints", "Success signals", "Examples"]}
